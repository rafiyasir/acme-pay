# Copy to .env.development (DATABASE_URL, WEB_ORIGIN, PORT) and .env.test (TEST_DATABASE_URL only).
# Neon direct connection string, sslmode=require, one branch per environment.
DATABASE_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@ep-example-test.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# The only origin CORS allows (no wildcard)
WEB_ORIGIN=http://localhost:5173
PORT=3000
